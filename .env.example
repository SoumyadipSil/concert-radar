# Supabase
NEXT_PUBLIC_SUPABASE_URL=          # Your Supabase project URL (https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # Supabase anon/public key (safe for browser)
SUPABASE_SERVICE_ROLE_KEY=         # Supabase service role key (server-only, never expose to client)

# Cron authentication
CRON_SECRET=                       # Random secret for authenticating GitHub Actions cron calls

# Last.fm
LASTFM_API_KEY=                    # Last.fm API key (https://www.last.fm/api/account/create)

# Ticketmaster
TICKETMASTER_API_KEY=              # Ticketmaster Discovery API key (https://developer.ticketmaster.com/)

# Telegram
TELEGRAM_BOT_TOKEN=               # Telegram Bot API token (from @BotFather)
TELEGRAM_WEBHOOK_SECRET=          # Random secret for verifying Telegram webhook requests

# Resend
RESEND_API_KEY=                    # Resend API key (https://resend.com/api-keys)
RESEND_FROM_EMAIL=                 # Verified sender email for Resend (e.g., alerts@yourdomain.com)

# App
NEXT_PUBLIC_APP_URL=               # Public URL of the app (e.g., https://concert-radar.vercel.app)
